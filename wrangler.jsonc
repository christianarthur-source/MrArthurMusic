{
  "name": "mrarthurmusic",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  // Branch builds run `wrangler preview`, which needs this block (it can stay empty).
  "previews": {},
  // Wolfi (the /wolfi notation app) accounts and saved scores. Separate from the K-6 classroom data.
  // The Music Teacher Hub (/Hub/) keeps its PIN, sessions and synced data in hub_* tables of the same database.
  "d1_databases": [
    { "binding": "WOLFI_DB", "database_name": "wolfi", "database_id": "bb19b483-93b5-4132-ae02-a774d4332646" },
    { "binding": "HUB_DB", "database_name": "wolfi", "database_id": "bb19b483-93b5-4132-ae02-a774d4332646" }
  ],
  // Workers AI (free daily allowance): the Hub's free lesson-plan AI (hub/server/freeAi.mjs).
  "ai": { "binding": "AI" },
  // Chrome Music Lab EXTRA Shared Piano: one Durable Object per room code relays notes between players
  // (cloudflare/pianoRoom.mjs). Nothing is stored. SQLite-backed class = available on the free plan.
  "durable_objects": {
    "bindings": [{ "name": "PIANO_ROOMS", "class_name": "PianoRoom" }]
  },
  "migrations": [{ "tag": "piano-rooms-v1", "new_sqlite_classes": ["PianoRoom"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
