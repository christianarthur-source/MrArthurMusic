{
  "name": "mrarthurmusic",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  // Branch builds run `wrangler preview`, which needs this block (it can stay empty).
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
